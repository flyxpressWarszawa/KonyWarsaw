MSW_WP_URL=https://mobilny-serwis-warszawa.pl
MSW_TRANSPORT_URL=https://mobilny-serwis-warszawa.pl/wp-content/plugins/msw-unified-engine/transport.php
MSW_NODE=msw-vps-1
MSW_SECRET=CHANGE_TO_THE_SCOPED_NODE_SECRET_FROM_WORDPRESS
MSW_DATA_DIR=/var/lib/msw-engine
MSW_MAX_JOB_SECONDS=300
MSW_MAX_JOB_MEMORY_MB=2048
MSW_WP_CRON_INTERVAL=300
# The central site's existing WordPress-provider worker runs the owner agent.
# Set 0 to pause its own connection checks and hourly private business briefs.
MSW_AUTONOMOUS_AGENT=1
MSW_RUNTIME_MODE=vps
# Optional local model. No weights are downloaded by this installer.
# Existing WordPress OpenAI router + existing Python HUB federation:
# MSW_LLM_PROVIDER=wordpress
# MSW_LLM_MODEL=gpt-5-mini
# Install wordpress/msw-render-federation, then enable llm.generate on the node.
# Provider API keys stay in their existing private WordPress configuration.
# MSW_LLM_BASE_URL=http://127.0.0.1:11434
# MSW_LLM_MODEL=an-already-installed-model
# Optional legacy resources on this VPS:
# MSW_DISCOVERY_CORPUS=/var/lib/msw-engine/corpus
# MSW_LEGACY_DATA_DB=/var/lib/msw-engine/receiver.sqlite3
# MSW_LEGACY_DATA_OUTPUT=/var/lib/msw-engine/datasets
# MSW_ENABLE_TRAINING=1
# MSW_TRAINING_MODES=tiny
# MSW_TRAINING_MAX_STEPS=100
