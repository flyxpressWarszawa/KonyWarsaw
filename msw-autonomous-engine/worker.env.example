MSW_WP_URL=https://mobilny-serwis-warszawa.pl
MSW_TRANSPORT_URL=https://mobilny-serwis-warszawa.pl/wp-content/plugins/msw-unified-engine/transport.php
MSW_NODE=msw-vps-1
MSW_SECRET=CHANGE_TO_THE_SCOPED_NODE_SECRET_FROM_WORDPRESS
MSW_DATA_DIR=/var/lib/msw-engine
MSW_MAX_JOB_SECONDS=300
MSW_MAX_JOB_MEMORY_MB=2048
MSW_WP_CRON_INTERVAL=3600
# The central site's existing WordPress-provider worker runs the owner agent.
# Set 0 to pause its own connection checks and hourly private business briefs.
MSW_AUTONOMOUS_AGENT=1
MSW_RUNTIME_MODE=vps
# Optional local model. No weights are downloaded by this installer.
# Direct paid OpenAI inference from this always-on Render worker (optional).
# Keep MSW_LLM_PROVIDER=wordpress to enable the existing autonomous-agent lanes.
# Set MSW_PAID_AI_TRANSPORT=direct_openai and MSW_LLM_MODEL=gpt-6.1-sol.
# Set MSW_OPENAI_MODEL=gpt-6.1-sol if a different model is desired.
# Store OPENAI_API_KEY only as a Render secret; never commit it or put it in WordPress pages.
# The direct transport records request IDs and avoids replaying uncertain paid requests.
# Existing WordPress OpenAI router + existing Python HUB federation:
# MSW_LLM_PROVIDER=wordpress
# MSW_LLM_MODEL=gpt-5-mini
# Install wordpress/msw-render-federation, then enable llm.generate on the node.
# Provider API keys stay in their existing private WordPress configuration.
# MSW_LLM_BASE_URL=http://127.0.0.1:11434
# MSW_LLM_MODEL=an-already-installed-model
# Optional legacy resources on this VPS:
# MSW_DISCOVERY_CORPUS=/var/lib/msw-engine/corpus
# MSW_LEGACY_DATA_DB=/var/lib/msw-engine/receiver.sqlite3
# MSW_LEGACY_DATA_OUTPUT=/var/lib/msw-engine/datasets
# MSW_ENABLE_TRAINING=1
# MSW_TRAINING_MODES=tiny
# MSW_TRAINING_MAX_STEPS=100

# Alibaba Cloud Model Studio / Singapore dedicated workspace (optional, opt-in).
# Endpoint is pinned in msw_engine/aliyun_direct.py, never provided by jobs.
# API key MUST be added as an encrypted Render environment variable, not committed.
# MSW_ALIYUN_API_KEY=<workspace-scoped-secret-in-Render-only>
# MSW_ALIYUN_MODEL=<exact-model-id-enabled-in-this-workspace>
# Enable only after an authenticated, billable one-request smoke test and explicit cost policy:
# MSW_PAID_AI_TRANSPORT=direct_aliyun
# Optional Qwen 3.8 typed modes; chat_stream matches the user's thinking/streaming example.
# MSW_ALIYUN_PROTOCOL=chat_stream
# MSW_ALIYUN_THINKING_BUDGET=256
# Responses API (non-streaming final text) is supported via MSW_ALIYUN_PROTOCOL=responses.
# Existing configured main provider remains unchanged until a VERIFIED paid probe and privacy review.
# MSW_ALIYUN_PROBE=1
# MSW_ALIYUN_PROBE_PROTOCOL=chat_stream
# MSW_ALIYUN_PROBE_RUN_ID=one-unique-owner-approved-test-id
# No raw Qwen reasoning, API key, or user prompts are printed in Render logs.
# Model Studio and Large Model Inference must be active for this workspace in Singapore.
# A missing key/model fails closed. Existing direct_openai and WordPress routes stay unchanged.
